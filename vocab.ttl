@prefix vocab: <https://pikajojo.github.io/Knowledge_Graph_UGent_Lab2/vocab.ttl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .


# Classes

vocab:Person
  a rdfs:Class ;
  rdfs:label "Person"@en ;
  rdfs:comment "A human person described in this dataset."@en ;
  rdfs:subClassOf foaf:Person .


vocab:Course 
  a rdfs:Class ;
    rdfs:label "Course"@en ;
    rdfs:comment "A course offered at an educational institution." .

vocab:City 
  a rdfs:Class ;
    rdfs:label "City"@en ;
    rdfs:comment "A place in this world with many people living in." .

vocab:Photo
  a rdfs:Class ;
  rdfs:label "Photo"@en ;
  rdfs:comment "which includes a person or sth." ;
  rdfs:subClassOf foaf:Image .

vocab:Cat
  a rdfs:Class ;
  rdfs:label "Cat"@en ;
  rdfs:comment "the cutest animal in the world." .

 
vocab:Poster
  a rdfs:Class ;
  rdfs:label "Poster"@en ;
  rdfs:comment "sth with some words or images." .





# Datatype Properties (literal values)

vocab:name
  a rdf:Property ;
  rdfs:label "name"@en ;
  rdfs:comment "The full name of a person."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf foaf:name .

vocab:hasHometown
  a rdf:Property ;
  rdfs:label "hometown"@en ;
  rdfs:comment "The hometown of a person (as a text literal)."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range xsd:string .

vocab:hasJobTitle
  a rdf:Property ;
  rdfs:label "job title"@en ;
  rdfs:comment "The job title or role of a person."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range xsd:string .

vocab:hasTelephone
  a rdf:Property ;
  rdfs:label "telephone"@en ;
  rdfs:comment "A telephone number of a person, stored as a string."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range xsd:string .

vocab:hasHobby
  a rdf:Property ;
  rdfs:label "hobby"@en ;
  rdfs:comment "A hobby of a person."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range xsd:string .

vocab:hasPhotoName
  a rdf:Property ;
  rdfs:label "photo name"@en ;
  rdfs:comment "A name of a photo."@en ;
  rdfs:domain vocab:Photo ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf foaf:name .


vocab:hasDescription
  a rdf:Property ;
  rdfs:label "description"@en ;
  rdfs:comment "A description of the photo."@en ;
  rdfs:domain vocab:Photo ;
  rdfs:range xsd:string .




# Object Properties (IRI/resource values)

vocab:url
  a rdf:Property ;
  rdfs:label "url"@en ;
  rdfs:comment "A link (IRI) to a web resource related to the person (e.g., personal website)."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range rdfs:Resource .

vocab:enrolledIn 
    a rdf:Property ;
    rdfs:label "enrolled in" ;
    rdfs:comment "Relates a person to a course they are enrolled in." ;
    rdfs:domain lab:Person ;
    rdfs:range lab:Course .

vocab:knows
  a rdf:Property ;
  rdfs:label "knows"@en ;
  rdfs:comment "Indicates that a person knows another person."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range vocab:Person ;
  rdfs:subPropertyOf foaf:knows .

vocab:beFriendWith
  a rdf:Property ;
  rdfs:label "be friend with"@en ;
  rdfs:comment "Indicates that a person is friends with another person."@en ;
  rdfs:domain vocab:Person ;
  rdfs:range vocab:Person .

vocab:hasCreator
  a rdf:Property ;
  rdfs:label "creator name"@en ;
  rdfs:comment "A name of a photo creator."@en ;
  rdfs:domain vocab:Photo ;
  rdfs:range vocab:Person ;
  rdfs:subPropertyOf foaf:maker .


vocab:hasDepicted
  a rdf:Property ;
  rdfs:label "person name"@en ;
  rdfs:comment "A name of person who is in the photo."@en ;
  rdfs:domain vocab:Photo ;
  rdfs:range vocab:Person ;
  rdfs:subPropertyOf foaf:depicts .

vocab:hasBeenTakenAt
  a rdf:Property ;
  rdfs:label "location name"@en ;
  rdfs:comment "A name of location where the photo is taken."@en ;
  rdfs:domain vocab:Photo ;
  rdfs:range vocab:Place .

vocab:hasUrl
  a rdf:Property ;
  rdfs:label "photo link"@en ;
  rdfs:comment "where you can see the photo on the internet."@en ;
  rdfs:domain vocab:Photo ;
  rdfs:range rdfs:Resource .




