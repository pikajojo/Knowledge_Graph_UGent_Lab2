:me a vocab:Person;
    vocab:name "Yajing Wang"^^xsd:string ;
    foaf:name "Yajing Wang"^^xsd:string ;
    schema:name "Yajing Wang"^^xsd:string ;
    vocab:hasHometown :Jinan;
    vocab:hasJobTitle "Phd student";
    vocab:url <http://www.pikajojo.github>;
    vocab:hasTelephone "17843108247";
    vocab:hasHobby "Cooking";
    foaf:knows tian:me, seppe:me, ward:me, thijs:me, marlin:me, odm:me;
    vocab:beFriendWith tian:me;
    vocab:enrolledIn :knowledge-graphs-2025.

:cat a vocab:Cat;


